FROM composer:2 AS composer-dependencies

WORKDIR /app

COPY composer.json composer.lock ./
COPY . .

RUN composer install \
    --no-dev \
    --no-interaction \
    --no-progress \
    --prefer-dist \
    --optimize-autoloader

FROM node:24-alpine AS frontend-assets

WORKDIR /app

COPY package.json package-lock.json ./

RUN npm ci --ignore-scripts

COPY resources ./resources
COPY public ./public
COPY vite.config.js .
COPY package.json .

RUN npm run build

FROM php:8.4-fpm-bookworm AS runtime

RUN apt-get update && apt-get install -y \
    libicu-dev \
    libjpeg62-turbo-dev \
    libonig-dev \
    libpng-dev \
    libwebp-dev \
    libzip-dev \
    zlib1g-dev \
    $PHPIZE_DEPS \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

RUN docker-php-ext-configure gd \
        --with-jpeg \
        --with-webp \
    && docker-php-ext-install -j$(nproc) \
        bcmath \
        exif \
        gd \
        intl \
        mbstring \
        opcache \
        pcntl \
        pdo_mysql \
        zip

RUN apt-get purge -y --auto-remove \
        libicu-dev \
        libjpeg62-turbo-dev \
        libonig-dev \
        libpng-dev \
        libwebp-dev \
        libzip-dev \
        zlib1g-dev \
        $PHPIZE_DEPS \
    && apt-get update \
    && apt-get install -y \
        libicu72 \
        libjpeg62-turbo \
        libonig5 \
        libpng16-16 \
        libwebp7 \
        libzip4 \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

COPY --from=composer:2 /usr/bin/composer /usr/bin/composer

WORKDIR /var/www/html

COPY --from=composer-dependencies /app/vendor ./vendor
COPY . .
COPY --from=composer-dependencies /app/bootstrap/cache/packages.php /var/www/html/bootstrap/cache/packages.php
COPY --from=composer-dependencies /app/bootstrap/cache/services.php /var/www/html/bootstrap/cache/services.php
COPY --from=frontend-assets /app/public/build ./public/build
COPY docker/php/php-production.ini /usr/local/etc/php/conf.d/99-production.ini

RUN mkdir -p \
        storage/framework/cache/data \
        storage/framework/sessions \
        storage/framework/views \
        storage/logs \
        bootstrap/cache \
    && chown -R www-data:www-data \
        storage/framework \
        storage/logs \
        bootstrap/cache \
    && chmod -R ug+rwX \
        storage/framework \
        storage/logs \
        bootstrap/cache

USER www-data

CMD ["php-fpm"]