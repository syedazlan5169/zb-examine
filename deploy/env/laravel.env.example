# Laravel runtime environment for both app and scheduler. Store the real file at:
# /etc/zb-examine/laravel.env
# Production uses the VPS-owned shared MySQL service over the external Docker
# network. Compose injects these values into the containers; keep the actual
# application password in the protected Compose env/runtime configuration.
# DB_CONNECTION=mysql
# DB_HOST=probono-mysql
# DB_PORT=3306
# DB_DATABASE=zb_examine
# DB_USERNAME=zb_examine_app
# DB_PASSWORD=<database-password>
# MYSQL_ROOT_PASSWORD must never be added here.

APP_NAME="Sistem Daftar Pemeriksaan"
APP_ENV=production
APP_KEY=<generate-once>
APP_DEBUG=false
APP_URL=https://<production-domain>
APP_LOCALE=ms
APP_FALLBACK_LOCALE=en
BUSINESS_TIMEZONE=Asia/Kuala_Lumpur

LOG_CHANNEL=stderr
LOG_LEVEL=info

SESSION_DRIVER=database
SESSION_LIFETIME=240
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax
SESSION_PATH=/
CACHE_STORE=database
QUEUE_CONNECTION=database

FILESYSTEM_DISK=local

PHOTO_UPLOAD_MODE=direct
PHOTO_UPLOAD_DISK=photo_uploads
PHOTO_UPLOAD_DIRECT_DISK=photo_uploads_spaces
PHOTO_UPLOAD_PRESIGN_TTL=300
PHOTO_PREVIEW_PRESIGN_TTL=120
EXAMINATION_PHOTO_MAX_DIMENSION=1600
EXAMINATION_PHOTO_QUALITY=72
PHOTO_CLEANUP_SETTLE_SECONDS=3600
PHOTO_CLEANUP_SESSION_LIMIT=100
PHOTO_CLEANUP_QUEUE_LIMIT=500

DO_SPACES_KEY=<spaces-access-key>
DO_SPACES_SECRET=<spaces-secret-key>
DO_SPACES_REGION=us-east-1
DO_SPACES_BUCKET=space-probono-apps
DO_SPACES_ENDPOINT=https://sgp1.digitaloceanspaces.com
DO_SPACES_USE_PATH_STYLE_ENDPOINT=false