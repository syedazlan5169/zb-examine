# Docker Compose interpolation only. Store the real file at:
# /etc/zb-examine/compose.env

RELEASE_ID=<full-deployed-git-sha>
LARAVEL_ENV_FILE=/etc/zb-examine/laravel.env

MYSQL_DATABASE=<database-name>
MYSQL_USER=<database-user>
# This is also the Laravel application's database password through Compose mapping.
MYSQL_PASSWORD=<database-password>
MYSQL_ROOT_PASSWORD=<mysql-root-password>